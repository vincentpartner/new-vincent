# Direkten Browser-Zugriff auf Konfiguration, Datenablage und Einrichtungsskript verbieten.
# (PHP kann sie weiterhin einlesen – das ist Datei-Ebene.)
<FilesMatch "^(config\.php|oauth-setup\.php|.*\.json|.*\.tmp|.*\.lock|.*\.txt)$">
  Require all denied
</FilesMatch>
# Für die einmalige OAuth-Einrichtung oauth-setup.php oben aus der Liste nehmen,
# danach wieder eintragen (oder Datei löschen).
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
